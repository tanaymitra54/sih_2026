# Backend
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="medguard-sih-2026-demo-secret"
# Pack signing: Ed25519 keypair. Leave unset to auto-generate + persist in backend/keys/.
# QR_PRIVATE_KEY / QR_PUBLIC_KEY = PEM strings to pin your own manufacturer keypair.
QR_HMAC_SECRET="medguard-qr-hmac-demo-secret"

# Recall email mock delivery (Gmail app password, never commit real credentials)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tanaymitra9@gmail.com"
SMTP_PASS="your-gmail-app-password"
RECALL_MOCK_EMAIL="tanay.mitra2024@vitstudent.ac.in"
# Single admin inbox for all problem alerts (counterfeit, suspicious, recalls).
# Falls back to RECALL_MOCK_EMAIL when unset. Same alert is re-emailed at most once per 10 min.
ALERT_EMAIL="tanay.mitra2024@vitstudent.ac.in"

# Frontend (Vite)
VITE_API_BASE="/api"

# AWS plane (see AGENTS.md). Set ORVYN_AWS_ENABLED=1 to turn on S3 / DynamoDB /
# SNS / CloudWatch / KMS mirroring. Leave 0 for offline local dev.
ORVYN_AWS_ENABLED=0
AWS_REGION="ap-southeast-2"
ORVYN_BUCKET="orvyn-artifacts-367722595624"
ORVYN_TABLE="orvyn-scan-events"
ORVYN_TOPIC_ARN="arn:aws:sns:ap-southeast-2:367722595624:orvyn-alerts"
ORVYN_KMS_ALIAS="alias/orvyn-pack-signer"
ORVYN_LAMBDA="orvyn-ledger-integrity"
